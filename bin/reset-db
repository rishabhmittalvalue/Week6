#!/usr/bin/env bash
# Rebuilds the database from the migration files in db/migrate. Every row is
# deleted; your files are not touched. Use it when the database is in a state
# you can't explain, then load the rows again with
# bin/rails runner scripts/create_data.rb.
#
#   bin/reset-db
set -e
cd "$(dirname "$0")/.."

bin/rails db:migrate:reset
echo "Database rebuilt from db/migrate. Every table is empty; bin/rails runner scripts/create_data.rb loads the rows."
